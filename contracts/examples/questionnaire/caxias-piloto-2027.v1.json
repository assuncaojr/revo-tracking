    },
    {
      "key": "P2", "type": "single", "role": "quota",
      "text": "Escolaridade",
      "options": [
        {"value": "ate_fund_incompleto", "label": "Até fundamental incompleto"},
        {"value": "fund_completo", "label": "Fundamental completo"},
        {"value": "medio", "label": "Médio"},
        {"value": "superior", "label": "Superior"}
      ]
    },
    {
      "key": "P3", "type": "single", "role": "profile",
      "text": "Bairro onde mora",
