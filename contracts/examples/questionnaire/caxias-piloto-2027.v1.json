      "options": [{"value": "aprova", "label": "Aprova"}, {"value": "desaprova", "label": "Desaprova"}]
    },
    {
      "key": "G2", "type": "single", "role": "approval",
      "text": "Como avalia a administração?",
      "options": [
        {"value": "otima", "label": "Ótima"},
        {"value": "boa", "label": "Boa"},
        {"value": "regular", "label": "Regular"},
        {"value": "ruim", "label": "Ruim"},
        {"value": "pessima", "label": "Péssima"}
      ]
    },
    {
      "key": "G3", "type": "scale", "role": "approval",
      "text": "Nota de 0 a 10 para a administração", "min": 0, "max": 10
    },
    {
      "key": "G4", "type": "grid", "role": "evaluation",
      "text": "Desde o início desta gestão, a situação melhorou, ficou igual ou piorou em…",
      "rows_list": "areas", "shuffle_rows": true,
      "options": [
        {"value": "melhorou", "label": "Melhorou"},
        {"value": "igual", "label": "Ficou igual"},
        {"value": "piorou", "label": "Piorou"}
      ]
    },
    {
      "key": "G5", "type": "single", "role": "evaluation",
      "text": "No seu bairro, a prefeitura fez alguma obra ou melhoria no último ano?",
      "options": [{"value": "sim", "label": "Sim"}, {"value": "nao", "label": "Não"}]
    },
    {
      "key": "G5a", "type": "text", "role": "open",
      "text": "Qual obra ou melhoria?",
      "show_if": {"key": "G5", "in": ["sim"]}
    },
    {
      "key": "G6", "type": "text", "role": "open",
      "text": "Qual o maior problema do seu bairro hoje?"
    },
    {
      "key": "G7", "type": "single", "role": "evaluation",
      "text": "Se o prefeito pudesse resolver só uma coisa na cidade, o que deveria ser?",
      "options_list": "areas", "shuffle": true
    },
    {
      "key": "V1", "type": "single", "role": "vote_past",
      "text": "Em quem você votou para prefeito em 2024?",
      "options": [
        {"value": "gentil_neto", "label": "Gentil Neto"},
        {"value": "paulinho", "label": "Paulinho"},
        {"value": "lycia_waquim", "label": "Lycia Waquim"},
        {"value": "edmilson_sanches", "label": "Edmilson Sanches"},
        {"value": "branco_nulo", "label": "Branco ou nulo", "fixed": true},
        {"value": "nao_votou", "label": "Não votou", "fixed": true},
        {"value": "nao_lembra", "label": "Não lembra", "fixed": true},
        {"value": "prefere_nao_dizer", "label": "Prefere não dizer", "fixed": true}
      ],
      "shuffle": true,
      "nonresponse": false
    },
    {
      "key": "E1", "type": "single", "role": "evaluation",
      "text": "Em 2028, prefere que o próximo prefeito continue o trabalho da gestão atual ou mude?",
      "options": [
        {"value": "continuar", "label": "Continuar"},
        {"value": "mudar", "label": "Mudar"},
        {"value": "depende", "label": "Depende"}
      ]
    },
    {
      "key": "E2", "type": "name", "role": "open",
      "text": "Quem você gostaria que fosse o próximo prefeito?",
      "hint": "Espontânea: não leia nomes. As sugestões são só para você, depois da resposta.",
      "list": "nomes", "allow_free_text": true
    },
    {
      "key": "C1", "type": "single", "role": "contact",
      "text": "Aceita deixar um WhatsApp para receber o resultado desta pesquisa sobre o seu bairro?",
      "options": [{"value": "sim", "label": "Sim"}, {"value": "nao", "label": "Não"}],
      "nonresponse": false
    },
    {
      "key": "C2", "type": "contact", "role": "contact",
      "text": "Nome e WhatsApp",
      "read_aloud": "Seu número será usado só para enviar o resultado desta pesquisa e pode ser apagado quando você pedir.",
      "consent_text_version": "c1-v1",
      "show_if": {"key": "C1", "in": ["sim"]},
      "nonresponse": false
    }
