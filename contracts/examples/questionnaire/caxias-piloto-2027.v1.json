      "nonresponse": false,
      "terminate_if": {"key": "F1", "in": ["nao"]}, "terminate_status": "screened_out"
    },
    {
      "key": "F2", "type": "number", "role": "quota",
      "text": "Idade", "min": 0, "max": 120,
      "nonresponse": false,
      "terminate_if": {"key": "F2", "lt": 16}, "terminate_status": "screened_out",
